---
import { CategoriasGrid } from "../components/CategoriasGrid";
import { ColaboraSection } from "../components/ColaboraSection";
import { ContactForm } from "../components/ContactForm";
import { Footer } from "../components/Footer";
import { HeroHeader } from "../components/HeroHeader";
import { LosPremios } from "../components/LosPremios";
import { Navbar } from "../components/Navbar";
import { Participacion } from "../components/Participacion";
import { Preinscripcion } from "../components/Preinscripcion";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Premios Huella Scout 2026 | Gala de Premios Scout en Jerez" description="Premios Huella 2026: la gala scout que reconoce el esfuerzo de jóvenes scouts y no scouts en Jerez de la Frontera. Organizado por el Grupo Scout Los Descalzos">
  <Navbar client:load />
  <main>
    <HeroHeader client:load title="PREMIOS HUELLA" />
    <LosPremios client:visible />
    <CategoriasGrid client:visible />
    <Preinscripcion client:visible />
    <Participacion client:visible />
    <ColaboraSection client:visible />
    <ContactForm client:visible />
  </main>
  <Footer client:visible />
</Layout>
