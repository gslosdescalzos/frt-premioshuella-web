---
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { ParticiparButton } from "../../components/ParticiparButton";
import { categories, participationRules } from "../../lib/categories";
import type { Category } from "../../lib/categories";

export function getStaticPaths() {
  return Object.entries(categories).map(([slug, category]) => ({
    params: { slug },
    props: { category, slug },
  }));
}

const { category, slug } = Astro.props as { category: Category; slug: string };
---

<Layout title={`${category.name} | Premios Huella Scout 2026`} description={`${category.description} Participa en los Premios Huella Scout 2026 en Jerez de la Frontera.`}>
  <Navbar client:load />
  <main>
    <section class="relative min-h-[50vh] flex items-center justify-center bg-neutral-950">
      <div class="absolute inset-0 bg-gradient-to-b from-huella-900/20 to-neutral-950" />
      <div class="relative z-10 text-center px-6 pt-24">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-4">
          {category.name}
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl mx-auto">
          {category.description}
        </p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white dark:from-neutral-950 to-transparent" />
    </section>

    <section class="py-24 bg-white dark:bg-neutral-950">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-12 text-center">
          Bases de la Categoría
        </h2>
        <ol class="space-y-6">
          {category.bases.map((base, index) => (
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-huella-100 dark:bg-huella-900/50 text-huella-700 dark:text-huella-300 flex items-center justify-center font-bold text-lg">
                {index + 1}
              </span>
              <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed pt-2">
                {base}
              </p>
            </li>
          ))}
        </ol>

        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-12 text-center mt-24">
          Reglas de Participación
        </h2>
        <ol class="space-y-6">
          {participationRules.map((rule, index) => (
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold text-lg">
                {index + 1}
              </span>
              <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed pt-2">
                {rule}
              </p>
            </li>
          ))}
        </ol>

        <div class="mt-16 text-center">
          <ParticiparButton
            client:load
            categoryName={category.name}
            categorySlug={slug}
          />
        </div>
      </div>
    </section>
  </main>
  <Footer client:visible />
</Layout>
