---
import Layout from "../../../layouts/Layout.astro";
import { Navbar } from "../../../components/Navbar";
import { Footer } from "../../../components/Footer";
import { ParticipationForm } from "../../../components/ParticipationForm";
import { categories } from "../../../lib/categories";

export function getStaticPaths() {
  return Object.entries(categories).map(([slug, category]) => ({
    params: { slug },
    props: { category, slug },
  }));
}

const { category, slug } = Astro.props as {
  category: (typeof categories)[string];
  slug: string;
};
---

<Layout title={`Participar - ${category.name}`}>
  <Navbar client:load />
  <main>
    <section class="relative min-h-[30vh] flex items-center justify-center bg-neutral-950">
      <div class="absolute inset-0 bg-gradient-to-b from-huella-900/20 to-neutral-950" />
      <div class="relative z-10 text-center px-6 pt-24">
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-white mb-4">
          Participar en {category.name}
        </h1>
        <p class="text-lg text-neutral-300 max-w-2xl mx-auto">
          {category.description}
        </p>
      </div>
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white dark:from-neutral-950 to-transparent" />
    </section>

    <section class="py-24 bg-white dark:bg-neutral-950">
      <div class="max-w-3xl mx-auto px-6">
        <ParticipationForm client:load categoryName={category.name} />
      </div>
    </section>
  </main>
  <Footer client:visible />
</Layout>
