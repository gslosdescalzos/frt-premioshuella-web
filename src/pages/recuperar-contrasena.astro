---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { ForgotPasswordForm } from "../components/ForgotPasswordForm";
import { Footer } from "../components/Footer";
---

<Layout title="Recuperar contraseña | Premios Huella Scout 2026" description="Recupera tu contraseña para acceder a tu cuenta de Premios Huella Scout 2026.">
  <Navbar client:load />
  <main>
    <section class="pt-32 pb-24 bg-white dark:bg-neutral-950 min-h-screen">
      <div class="max-w-md mx-auto px-6">
        <div class="text-center mb-8">
          <h1 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-2">
            Recuperar contraseña
          </h1>
        </div>
        <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 shadow-sm">
          <ForgotPasswordForm client:load />
        </div>
      </div>
    </section>
  </main>
  <Footer client:visible />
</Layout>
